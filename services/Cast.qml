pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick

// Выбор демонстрации экрана окном ochre (CastWindow.qml) вместо GTK-диалога xdg-desktop-portal-gnome.
// Бэкенд портала — extras/portal/ochre-portal.py (D-Bus activation); shell подключается к нему мостом `--client`
// и получает запросы {"op": "pick", …}, ответ — {"op": "answer", "id", "choice"}.
// При shell.cast пишет (только если изменилось):
//   ~/.local/share/xdg-desktop-portal/portals/ochre.portal             — бэкенд для портала
//   ~/.local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.ochre.service — как его запустить
//   ~/.config/xdg-desktop-portal/niri-portals.conf                      — ScreenCast=ochre (с пометкой ochre;
//                                                                         свой файл пользователя не трогаем)
// и перезапускает xdg-desktop-portal — только когда не идёт ни одной демонстрации (иначе их оборвёт).
// Выключили — помеченный niri-portals.conf удаляется, демонстрация снова через gnome.
// Shell не запущен — демон сам передаёт сессию gnome, так что демонстрация работает всегда.
Singleton {
    id: root

    readonly property bool enabled: Settings.get("shell.cast") && !Settings.greeterMode && Settings.writable
    readonly property string home: Quickshell.env("HOME")
    readonly property string daemon: Quickshell.shellDir + "/extras/portal/ochre-portal.py"
    readonly property string marker: "# ochre: generated by shell.cast — delete this line to keep the file as your own"

    property var request: null        // {id, app, types, multiple} — ждёт выбора
    property bool connected: false

    function answer(choice) {
        if (!request) return;
        bridge.write(JSON.stringify({ op: "answer", id: request.id, choice: choice ?? null }) + "\n");
        request = null;
    }

    // ── мост к демону ──
    Process {
        id: bridge
        running: root.enabled && root.installed
        command: ["python3", "-I", root.daemon, "--client"]
        stdinEnabled: true
        stdout: SplitParser {
            onRead: line => {
                let m = null;
                try { m = JSON.parse(line); } catch (e) { return; }
                if (m.op === "connected") root.connected = true;
                else if (m.op === "pick") root.request = m;
                else if (m.op === "cancel" && root.request?.id === m.id) root.request = null;
            }
        }
        onRunningChanged: if (!running) { root.connected = false; root.request = null; if (root.enabled && root.installed) again.start(); }
    }
    // демон перезапустился (обновили shell) или упал — переподключиться
    Timer { id: again; interval: 2000; onTriggered: if (!bridge.running && root.enabled && root.installed) bridge.running = true }

    // ── файлы портала ──
    property bool installed: false

    onEnabledChanged: setup.restart()
    Component.onCompleted: setup.restart()
    Timer { id: setup; interval: 1000; onTriggered: root.writeFiles() }

    function writeFiles() {
        if (Settings.greeterMode || !Settings.writable) return;
        files.command = ["sh", "-c", `
            on=$1 daemon=$2 marker=$3 h=$HOME changed=0 restart=0
            put() {  # put <файл> <текст>: пишет, только если отличается
                [ -f "$1" ] && [ "$(cat "$1")" = "$2" ] && return 0
                mkdir -p "$(dirname "$1")" && printf '%s\\n' "$2" > "$1.tmp" && mv "$1.tmp" "$1" && changed=1
            }
            conf="$h/.config/xdg-desktop-portal/niri-portals.conf"
            if [ "$on" = true ]; then
                put "$h/.local/share/xdg-desktop-portal/portals/ochre.portal" "[portal]
DBusName=org.freedesktop.impl.portal.desktop.ochre
Interfaces=org.freedesktop.impl.portal.ScreenCast;"
                restart=$changed   # новый бэкенд портал увидит только после перезапуска
                changed=0
                put "$h/.local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.ochre.service" "[D-BUS Service]
Name=org.freedesktop.impl.portal.desktop.ochre
Exec=/usr/bin/python3 -I $daemon"
                [ $changed = 1 ] && busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1
                if [ -f "$conf" ] && ! grep -qxF "$marker" "$conf"; then
                    echo "own"; exit 0   # свой файл пользователя — не трогаем
                fi
                changed=0
                sys=$(grep -v '^org.freedesktop.impl.portal.ScreenCast=' /usr/share/xdg-desktop-portal/niri-portals.conf 2>/dev/null \\
                      || printf '[preferred]\\ndefault=gnome;gtk;')
                put "$conf" "$marker
$sys
org.freedesktop.impl.portal.ScreenCast=ochre;gnome;"
                [ $changed = 1 ] && restart=1
            elif [ -f "$conf" ] && grep -qxF "$marker" "$conf"; then
                rm -f "$conf"; restart=1
            fi
            [ $restart = 1 ] && echo restart
            exit 0`, "sh", String(enabled), daemon, marker];
        files.running = true;
    }

    property bool needRestart: false

    Process {
        id: files
        stdout: StdioCollector {
            onStreamFinished: {
                const out = text.trim();
                root.installed = root.enabled && out !== "own";
                if (out === "own")
                    console.warn("cast: ~/.config/xdg-desktop-portal/niri-portals.conf — свой, ochre его не меняет; добавьте org.freedesktop.impl.portal.ScreenCast=ochre;gnome;");
                if (out.includes("restart")) { root.needRestart = true; root.tryRestart(); }
            }
        }
    }

    // портал читает настройки только при запуске; перезапуск оборвал бы идущие демонстрации — ждём, пока их нет
    function tryRestart() {
        if (!needRestart || Niri.casts.length > 0) return;
        needRestart = false;
        Quickshell.execDetached(["systemctl", "--user", "try-restart", "xdg-desktop-portal.service"]);
    }

    Connections {
        target: Niri
        function onCastsChanged() { root.tryRestart(); }
    }

    IpcHandler {
        target: "cast"
        function get(): string {
            return (root.connected ? "connected" : "not connected") + (root.request ? I18n.tr(", ждёт выбора: ") + JSON.stringify(root.request) : "");
        }
        function cancel(): void { root.answer(null); }
    }
}

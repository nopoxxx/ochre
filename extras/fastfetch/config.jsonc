// ochre: fastfetch — стиль panel (Mod+S → вид → стиль fastfetch); сгенерировано ochre, ручные правки перезапишутся.
// Свой конфиг: удалить эту строку — ochre перестанет его трогать.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {"type":"file","source":"~/.config/quickshell/extras/fastfetch/ochre-large.txt","color":{"1":"38;2;215;153;33","2":"38;2;215;153;33"},"padding":{"top":1,"left":2,"right":4}},
    "display": {"separator":"  ","color":{"keys":"90","output":"default","separator":"90"},"key":{"width":8},"size":{"binaryPrefix":"jedec","ndigits":1}},
    "modules": [
        "break",
        {"type":"title","format":"{#1;32}{user-name}{#0;90}@{#1;36}{host-name}"},
        {"type":"custom","format":"{#90}────────────────────────────────────────"},
        {"type":"os","key":"os","format":"{pretty-name} {arch}"},
        {"type":"kernel","key":"kernel","format":"{release}"},
        {"type":"uptime","key":"uptime"},
        {"type":"packages","key":"pkgs"},
        {"type":"wm","key":"wm","format":"{pretty-name} {version}"},
        {"type":"command","key":"ochre","text":"git -C ~/.config/quickshell log -1 --format='%h · %cr' 2>/dev/null || cat /usr/share/ochre/VERSION 2>/dev/null || echo '?'"},
        {"type":"command","key":"shell","text":"basename \"$SHELL\""},
        {"type":"terminal","key":"term","format":"{pretty-name} {version}"},
        {"type":"custom","format":"{#90}────────────────────────────────────────"},
        {"type":"cpu","key":"cpu","format":"{name} ×{cores-logical}"},
        {"type":"gpu","key":"gpu","format":"{name}"},
        {"type":"memory","key":"mem","format":"{used} / {total} {#90}{percentage}"},
        {"type":"disk","key":"disk","folders":"/","format":"{size-used} / {size-total} {#90}{size-percentage}"},
        {"type":"localip","key":"net","format":"{ifname} {ipv4}","showIpv4":true},
        "break",
        {"type":"colors","symbol":"block","paddingLeft":0}
    ]
}

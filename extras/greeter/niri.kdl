// niri для greeter ochre — только окно входа.
// greetd: [default_session] command = "niri -c /etc/greetd/ochre-niri.kdl", user = "greeter"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
}

layout {
    background-color "#1d2021"
}

include "/var/lib/ochre-greeter/.greeter/niri.kdl"

// когда greeter передал управление сессии, quickshell выходит — закрываем niri,
// и greetd запускает выбранную сессию
spawn-at-startup "sh" "-c" "OCHRE_GREETER=1 qs -p /usr/share/ochre/greeter.qml; niri msg action quit --skip-confirmation"

binds {
}
